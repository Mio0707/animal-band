{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animalbank.local/schemas/lesson-recipe.schema.json",
  "title": "Animal Bank Lesson Recipe V4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "algorithmVersion",
    "recipeId",
    "preparationId",
    "songId",
    "stageId",
    "generatedAt",
    "mode",
    "source",
    "songContext",
    "selection",
    "classFlow",
    "activities",
    "teachingAssetResolution",
    "generationStatus",
    "reviewStatus",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "4.0.0"
    },
    "algorithmVersion": {
      "type": "string"
    },
    "recipeId": {
      "type": "string"
    },
    "preparationId": {
      "type": "string"
    },
    "songId": {
      "type": "string"
    },
    "stageId": {
      "const": "stage_1"
    },
    "generatedAt": {
      "type": "string"
    },
    "mode": {
      "const": "ACTIVITY_SEQUENCE"
    },
    "source": {
      "type": "object"
    },
    "songContext": {
      "type": "object"
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activityTypes",
        "rhythmMaterialIds",
        "measuresPerUnit"
      ],
      "properties": {
        "activityTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "listen",
              "melody_trace",
              "rhythm_learning",
              "singing",
              "ensemble",
              "sticker_arrangement"
            ]
          }
        },
        "rhythmMaterialIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "measuresPerUnit": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "classFlow": {
      "type": "array",
      "minItems": 1
    },
    "activities": {
      "type": "array",
      "minItems": 1
    },
    "teachingAssetResolution": {
      "type": "object"
    },
    "generationStatus": {
      "enum": [
        "READY_FOR_ASSETS",
        "BLOCKED"
      ]
    },
    "reviewStatus": {
      "enum": [
        "NOT_REVIEWED",
        "REVIEWED"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
