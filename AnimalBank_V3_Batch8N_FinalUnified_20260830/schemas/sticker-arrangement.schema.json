{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animalbank.local/schemas/sticker-arrangement.schema.json",
  "title": "Sticker Arrangement Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runtimeVersion", "preparationId", "songId", "measureCount", "trackIds", "events", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "runtimeVersion": { "type": "string", "minLength": 1 },
    "preparationId": { "type": "string", "pattern": "^prep_[A-Za-z0-9_-]+$" },
    "songId": { "type": "string", "minLength": 1 },
    "measureCount": { "type": "integer", "minimum": 1, "maximum": 512 },
    "trackIds": {
      "type": "array",
      "prefixItems": [
        { "const": "dog" },
        { "const": "bear" },
        { "const": "cat" },
        { "const": "lion" }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["measure", "trackId", "state"],
        "properties": {
          "measure": { "type": "integer", "minimum": 1 },
          "trackId": { "enum": ["dog", "bear", "cat", "lion"] },
          "state": { "enum": ["on", "off"] }
        }
      }
    },
    "updatedAt": { "type": ["string", "null"] }
  }
}
