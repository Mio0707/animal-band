{
  "schemaVersion": "1.4.0",
  "libraryId": "animalbank_stage1_teaching_asset_library_v1_4",
  "title": "Animal Bank 第一学段 Teaching Asset Library V1.4 Final",
  "stageId": "stage_1",
  "grades": [
    1,
    2
  ],
  "status": "frozen_for_v3_p0",
  "purpose": "把 Curriculum Library 中已经确定的音乐材料，转成可被 Content Factory、Teaching Asset Resolver、Lesson Recipe Generator 与 Classroom Runtime 直接调用的标准教学资产。",
  "corePrinciples": [
    "Teaching Asset 回答“这个音乐材料怎么教”。",
    "Teaching Asset 与具体歌曲解耦。",
    "第一学段 Rhythm 教学采用时值唱名与身体动作同步教学。",
    "身体动作优先大动作、高对比、低精细度，适合1–2年级儿童执行。",
    "一个 Rhythm Pattern 最多使用2类主要身体动作；左右拍腿视为同一类交替动作体系。",
    "DOG 负责清楚示范，不承担动作评分。",
    "训练音频在 Content Factory 阶段预生成或缓存，课堂不依赖实时生成。",
    "Melody/Singing 的具体 pitch、solfege、lyrics、duration 必须来自 Verified Score。",
    "短旋律 Phrase 是旋律教学的主对象；上行、下行、重复音、do-mi-sol 等作为 Feature Support。",
    "Teaching Asset 审核与具体 Preparation Readiness 检查分开。"
  ],
  "namingRules": {
    "characterName": "DOG",
    "forbiddenLegacyNames": [
      "BEGO",
      "bego"
    ],
    "runtimeExample": "WATCH_DOG",
    "assetPrefixExample": "dog_rhythm_pat03"
  },
  "actionVocabulary": {
    "CLAP": {
      "labelZh": "拍手",
      "instructionZh": "双手在胸前自然拍一下。",
      "bodyZone": "上半身",
      "motorType": "gross_motor",
      "soundProducing": true
    },
    "PAT": {
      "labelZh": "双手拍腿",
      "instructionZh": "双手同时拍两侧大腿一下。",
      "bodyZone": "大腿",
      "motorType": "gross_motor",
      "soundProducing": true
    },
    "PAT_LEFT": {
      "labelZh": "左手拍左腿",
      "instructionZh": "左手拍左侧大腿一下。",
      "bodyZone": "左侧大腿",
      "motorType": "gross_motor",
      "soundProducing": true
    },
    "PAT_RIGHT": {
      "labelZh": "右手拍右腿",
      "instructionZh": "右手拍右侧大腿一下。",
      "bodyZone": "右侧大腿",
      "motorType": "gross_motor",
      "soundProducing": true
    },
    "STOMP": {
      "labelZh": "原地跺脚",
      "instructionZh": "原地自然踩地一下，不要求跳起。",
      "bodyZone": "脚下",
      "motorType": "gross_motor",
      "soundProducing": true
    },
    "FREEZE": {
      "labelZh": "张开双手定格",
      "instructionZh": "双手自然张开在身体两侧，身体和声音同时停住，心里继续数拍。",
      "bodyZone": "全身",
      "motorType": "gross_motor",
      "soundProducing": false,
      "internalPulseContinues": true
    }
  },
  "rhythmTeachingPolicy": {
    "runtimeFlow": [
      "LISTEN",
      "WATCH_DOG",
      "CHANT",
      "BODY_PLAY",
      "PRACTICE",
      "SONG_PLAY",
      "DONE"
    ],
    "stateDefinitions": {
      "LISTEN": {
        "system": "播放目标节奏示范。",
        "child": "先听，不要求立即动作。"
      },
      "WATCH_DOG": {
        "system": "DOG 同步示范身体动作。",
        "child": "观察节奏符号、时值唱名和动作的对应关系。"
      },
      "CHANT": {
        "system": "显示节奏符号与时值唱名，并按节拍高亮。",
        "child": "先只唱时值唱名，不做身体动作。"
      },
      "BODY_PLAY": {
        "system": "按同一节拍高亮节奏符号、时值唱名与 DOG 动作。",
        "child": "一边唱时值唱名，一边做对应身体动作。",
        "synchronized": true
      },
      "PRACTICE": {
        "system": "播放 Training Audio 循环或使用 BPM 时钟连续练习。",
        "child": "连续重复“嘴巴唱 + 身体做”，熟悉后逐渐弱化唱名提示。"
      },
      "SONG_PLAY": {
        "system": "回到真实歌曲，使用已学 Pattern 进行身体伴奏。",
        "child": "跟随歌曲共同速度，把 Pattern 放进真实音乐中。"
      },
      "DONE": {
        "system": "结束当前 Pattern 学习。",
        "child": "完成目标 Pattern 的“听 → 唱 → 动 → 练 → 歌曲应用”。"
      }
    },
    "teachingMapping": {
      "notation": "节奏符号",
      "chant": "时值唱名",
      "bodyAction": "身体动作",
      "goal": "建立节奏符号 ↔ 时值唱名 ↔ 身体动作的三重对应"
    },
    "chantSystem": {
      "quarter": "da",
      "eighth": "de",
      "sixteenth": "di",
      "rest": "kong"
    },
    "bodyDesignRules": [
      "动作必须清楚明确，儿童看一次即可模仿。",
      "优先使用拍手、拍腿、跺脚、定格等大动作。",
      "不同动作之间身体位置差异要明显。",
      "不使用手指轻点等精细动作作为核心节奏动作。",
      "不要求动作角度、力度或拍击位置高度精确。",
      "教学目标是节奏结构外化，不是舞蹈动作精度。",
      "Runtime 不对儿童具体姿势进行动作评分。"
    ],
    "performerAssetPack": {
      "assetPackId": "animalbank-stage1-rhythm-performer-v1",
      "mode": "compose_from_body_actions",
      "manifestPath": "data/runtime/rhythm/rhythm-performer-manifest.json",
      "actionMapPath": "data/runtime/rhythm/rhythm-action-map.json",
      "availability": "ready"
    }
  },
