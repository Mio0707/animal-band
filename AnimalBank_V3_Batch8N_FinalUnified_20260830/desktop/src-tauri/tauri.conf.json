{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "动物乐队课堂",
  "version": "0.1.0",
  "identifier": "com.animalband.classroom",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "动物乐队课堂", "width": 1180, "height": 780, "minWidth": 860, "minHeight": 620, "center": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "动物乐队跨平台离线课堂播放器",
    "fileAssociations": [{ "ext": ["animalclass"], "mimeType": "application/vnd.animal-band.classroom+zip", "description": "动物乐队离线课程" }]
  }
}
