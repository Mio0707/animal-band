    "melody": {
      "targets": {
        "core": [
          {
            "id": "MEL-12-HILO-01",
            "name": "分辨高与低",
            "description": "通过听觉和身体动作分辨明显的高音与低音。"
          },
          {
            "id": "MEL-12-ORDER-01",
            "name": "感受音高顺序",
            "description": "能够感知并表现越来越高、越来越低、保持差不多。"
          },
          {
            "id": "MEL-12-CONTOUR-01",
            "name": "旋律走向",
            "allowed_contours": [
              "UP",
              "DOWN",
              "LEVEL",
              "MIXED"
            ],
            "description": "能够听辨、模仿和表现短旋律中的基本走向。"
          },
          {
            "id": "MEL-12-MATCH-01",
            "name": "听后模唱",
            "learning_path": [
              "LISTEN",
              "COPY",
              "CHECK_BY_EAR",
              "REPEAT"
            ]
          },
          {
            "id": "MEL-12-PHRASE-01",
            "name": "短旋律乐句",
            "description": "能够听、记忆并模唱短小旋律乐句。"
          },
          {
            "id": "MEL-12-REPEAT-01",
            "name": "重复音/重复旋律感知",
            "description": "能够发现同一个音重复，或相同/相似短旋律再次出现。"
          },
          {
            "id": "MEL-12-ASC-DESC-01",
            "name": "上行/下行演唱",
            "description": "能够跟随示范唱出简单上行、下行音组，并用动作辅助音高变化。"
          }
        ],
        "progression": [
          {
            "id": "MEL-12-PITCH-GROUP-01",
            "name": "小音组快速识读",
            "description": "能够把连续的2–3个音作为一个小音组识读和模唱。"
          }
        ]
      },
      "pitch_materials": [
        {
          "id": "PITCH-SET-DMS",
          "name": "do–mi–sol音组",
          "level": "core_implementation_material",
          "degrees": [
            1,
            3,
            5
          ],
          "solfege": [
            "do",
            "mi",
            "sol"
          ],
          "uses": [
            "音高记忆",
            "简单接唱",
            "短旋律编创",
            "身体高低映射"
          ]
        },
        {
          "id": "PITCH-SCALE-7",
          "name": "基本七音唱名",
          "level": "core_recognition",
          "degrees": [
            1,
            2,
            3,
            4,
            5,
            6,
            7
          ],
          "solfege": [
            "do",
            "re",
            "mi",
            "fa",
            "sol",
            "la",
            "si"
          ]
        },
        {
          "id": "PITCH-OCTAVE-VARIANT",
          "name": "高/中/低音区同名音",
          "level": "progression",
          "schema": {
            "degree": "1..7",
            "octave": [
              -1,
              0,
              1
            ]
          }
        }
      ],
      "machine_materials": [
        {
          "id": "MEL-MAT-REPEAT-NOTE",
          "name": "重复音",
          "match_type": "deterministic",
          "rule": "连续两个及以上非休止音，degree与octave均相同。"
        },
        {
          "id": "MEL-MAT-ASCENDING",
          "name": "简单上行",
          "match_type": "semi_deterministic",
          "rule": "连续短音组总体向上，至少发生一次真实升高，不允许出现明显反向大跳；P0阈值由实现层配置。"
        },
        {
          "id": "MEL-MAT-DESCENDING",
          "name": "简单下行",
          "match_type": "semi_deterministic",
          "rule": "与简单上行相反；P0阈值由实现层配置。"
        },
        {
          "id": "MEL-MAT-LEVEL",
          "name": "平稳/重复为主",
          "match_type": "hybrid",
          "rule": "P0可只识别纯重复音，复杂平稳感由人工标签补充。"
        },
        {
          "id": "MEL-MAT-DMS",
          "name": "do-mi-sol音组片段",
          "match_type": "deterministic_plus_review",
          "rule": "片段只使用degree 1/3/5，并具有足够重复或清晰短句特征。"
        },
        {
          "id": "MEL-MAT-SHORT-PHRASE",
          "name": "适龄短旋律候选",
          "match_type": "parameterized",
          "output_fields": [
            "phraseId",
            "startMeasure",
            "endMeasure",
            "pitchRangeSemitones",
            "noteCount",
            "contour",
            "degrees"
          ],
          "requires_human_review": true
        },
        {
          "id": "MEL-MAT-SIMILAR-PHRASE",
          "name": "相同/相似乐句",
          "level": "progression",
          "match_type": "future_algorithm_or_manual",
          "p0_implementation": "允许人工标注similarToPhraseId，不做复杂旋律相似度算法。"
        }
      ]
    },
