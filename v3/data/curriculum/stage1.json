      "targets": {
        "core": [
          {
            "id": "RHY-12-BEAT-01",
            "name": "稳定均拍",
            "description": "能够随音乐找到并用踏步、拍腿、点头、拍手等动作保持基本稳定的共同拍。"
          },
          {
            "id": "RHY-12-TEMPO-01",
            "name": "感受并跟随速度",
            "description": "能够听辨明显快慢，并根据音乐速度调整身体动作。"
          },
          {
            "id": "RHY-12-DURATION-01",
            "name": "基本时值长短关系",
            "description": "通过听、唱、动作和符号，感知并表现全音符、二分音符、四分音符、八分音符、十六分音符的长短关系。"
          },
          {
            "id": "RHY-12-CHANT-01",
            "name": "使用时值唱名读节奏",
            "description": "能够看简单节奏唱出、听后模仿，并在唱熟后转为身体或打击乐演奏。"
          },
          {
            "id": "RHY-12-REST-01",
            "name": "休止与准确返回",
            "description": "理解休止也有时值长度，能够身体停止，并在休止结束后准确返回共同拍。",
