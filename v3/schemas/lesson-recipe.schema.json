{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://animalbank.local/schemas/lesson-recipe.schema.json",
  "title":"Animal Bank Lesson Recipe V2",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","algorithmVersion","recipeId","preparationId","songId","stageId","generatedAt","mode","source","songContext","selection","classFlow","activities","teachingAssetResolution","generationStatus","reviewStatus","warnings"],
  "properties":{
    "schemaVersion":{"const":"2.0.0"},"algorithmVersion":{"type":"string","minLength":1},"recipeId":{"type":"string","minLength":1},"preparationId":{"type":"string","minLength":1},"songId":{"type":"string","minLength":1},"stageId":{"const":"stage_1"},"generatedAt":{"type":"string","minLength":1},
    "mode":{"enum":["RHYTHM_ONLY","MELODY_ONLY","MELODY_SINGING","RHYTHM_MELODY","INTEGRATED"]},
    "source":{"type":"object","additionalProperties":false,"required":["learningProfileAlgorithmVersion","learningProfileGeneratedAt","scoreVerifiedAt"],"properties":{"learningProfileAlgorithmVersion":{"type":"string","minLength":1},"learningProfileGeneratedAt":{"type":["string","null"]},"scoreVerifiedAt":{"type":["string","null"]}}},
    "songContext":{"type":"object","additionalProperties":false,"required":["meter","bpm"],"properties":{"meter":{"type":"object"},"bpm":{"type":"number","exclusiveMinimum":0}}},
    "selection":{"type":"object","additionalProperties":false,"required":["modules","rhythmMaterialIds","phraseIds"],"properties":{"modules":{"type":"array","items":{"type":"string"}},"rhythmMaterialIds":{"type":"array","items":{"type":"string"}},"phraseIds":{"type":"array","items":{"type":"string"}}}},
    "classFlow":{"type":"array","minItems":5,"items":{"type":"object","additionalProperties":false,"required":["phase","active"],"properties":{"phase":{"enum":["EXPERIENCE_SONG","RHYTHM_LEARNING","MELODY_SINGING","GROUP_REHEARSAL","FINAL_ENSEMBLE"]},"active":{"type":"boolean"}}}},
    "activities":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["activityId","phase","module","teachingAssetIds","materialIds","phraseIds","bindings"],"properties":{"activityId":{"type":"string","minLength":1},"phase":{"enum":["EXPERIENCE_SONG","RHYTHM_LEARNING","MELODY_SINGING","GROUP_REHEARSAL","FINAL_ENSEMBLE"]},"module":{"enum":["shared","rhythm","melody","melody_singing","ensemble"]},"teachingAssetIds":{"type":"array","items":{"type":"string"}},"materialIds":{"type":"array","items":{"type":"string"}},"phraseIds":{"type":"array","items":{"type":"string"}},"bindings":{"type":"object","additionalProperties":true}}}},
    "teachingAssetResolution":{"type":"object","additionalProperties":false,"required":["resolvedAssetIds","unresolvedRequired","unresolvedOptional","allRequiredResolved"],"properties":{"resolvedAssetIds":{"type":"array","items":{"type":"string"}},"unresolvedRequired":{"type":"array","items":{"type":"object"}},"unresolvedOptional":{"type":"array","items":{"type":"object"}},"allRequiredResolved":{"type":"boolean"}}},
    "generationStatus":{"enum":["READY_FOR_ASSETS","BLOCKED"]},"reviewStatus":{"enum":["NOT_REVIEWED","REVIEWED"]},"warnings":{"type":"array","items":{"type":"string"}}
  }
}
