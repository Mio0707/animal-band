{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://animalbank.local/schemas/material-match-result.schema.json",
  "title": "Animal Bank Material Match Result",
  "type": "object",
  "required": ["schemaVersion", "algorithmVersion", "songId", "stageId", "sourceScoreStatus", "sourceScoreVerifiedAt", "generatedAt", "facts", "materials", "summary"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "algorithmVersion": { "type": "string", "minLength": 1 },
    "songId": { "type": "string", "minLength": 1 },
    "stageId": { "const": "stage_1" },
    "sourceScoreStatus": { "const": "verified" },
    "sourceScoreVerifiedAt": { "type": ["string", "null"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "facts": {
      "type": "object",
      "required": ["meter", "bpm", "usedDegrees", "pitchRangeSemitones", "restOccurrences"],
      "properties": {
        "meter": {
          "type": "object",
          "required": ["beats", "unit"],
          "properties": {
            "beats": { "type": "integer", "minimum": 1 },
            "unit": { "type": "integer", "minimum": 1 }
          }
        },
        "bpm": { "type": "number", "exclusiveMinimum": 0 },
        "usedDegrees": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 7 }, "uniqueItems": true },
        "pitchRangeSemitones": { "type": ["number", "null"], "minimum": 0 },
        "restOccurrences": { "type": "array", "items": { "type": "object" } }
      }
    },
    "materials": {
      "type": "object",
      "required": ["rhythm", "melody"],
      "properties": {
        "rhythm": { "$ref": "#/$defs/materialArray" },
        "melody": { "$ref": "#/$defs/materialArray" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["matchedMaterialIds", "rhythmMaterialCount", "melodyMaterialCount", "occurrenceCount"],
      "properties": {
        "matchedMaterialIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "rhythmMaterialCount": { "type": "integer", "minimum": 0 },
        "melodyMaterialCount": { "type": "integer", "minimum": 0 },
        "occurrenceCount": { "type": "integer", "minimum": 0 }
      }
    },
    "unsupportedP0": { "type": "object" },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "materialArray": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["materialId", "module", "name", "matchType", "confidence", "reviewRequired", "occurrences"],
        "properties": {
          "materialId": { "type": "string", "minLength": 1 },
          "module": { "enum": ["rhythm", "melody"] },
          "name": { "type": "string", "minLength": 1 },
          "matchType": { "type": "string", "minLength": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "reviewRequired": { "type": "boolean" },
          "occurrences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["occurrenceId", "measureStart", "measureEnd", "startNoteId", "endNoteId", "noteIds"],
              "properties": {
                "occurrenceId": { "type": "string", "minLength": 1 },
                "measureStart": { "type": "integer", "minimum": 1 },
                "measureEnd": { "type": "integer", "minimum": 1 },
                "startNoteId": { "type": "string", "minLength": 1 },
                "endNoteId": { "type": "string", "minLength": 1 },
                "noteIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
